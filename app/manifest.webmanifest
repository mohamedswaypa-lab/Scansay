    { "src": "/app/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Inkorg", "url": "/app/#inbox", "icons": [{ "src": "/app/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Översikt", "url": "/app/#overview", "icons": [{ "src": "/app/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
