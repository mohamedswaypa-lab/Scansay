{
  "name": "ScanSay",
  "short_name": "ScanSay",
  "description": "Gästernas meddelanden, larm och svar – i mobilen.",
  "id": "/app/",
  "start_url": "/app/#inbox",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0A0F1C",
